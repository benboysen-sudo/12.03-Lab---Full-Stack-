extends layout

block content
  h1= title
  p Welcome to #{title}

  h2 Add a new task
  form(method='POST' action='/create')
    label(for='task') Task:
    input(type='text', name='task', id='task', required, pattern='.*\\S.*', title='Task cannot be blank')
    button(type='submit') Create Task

  hr
  h2 Current Tasks
  if todos.length === 0
    p.empty No tasks yet.
  ol.todos
    each val in todos
      li(class=val.completed > 0 ? 'done' : '')
        div.task-header
          span.task-name= val.task
          if val.completed > 0
            span.status.completed Completed
          else
            span.status.pending Not Completed
        div.actions
          button.edit-toggle(type='button') Edit Task
          form.edit-form(method='POST' action='/edit' hidden)
            input(type='hidden', name='id', value=val.id)
            input(type='text', name='task', value=val.task, required, pattern='.*\\S.*', title='Task cannot be blank')
            button(type='submit') Save Edit
            button.secondary.cancel-edit(type='button') Cancel
          form(method='POST' action='/toggle')
            input(type='hidden', name='id', value=val.id)
            if val.completed > 0
              button(type='submit') Mark Not Completed
            else
              button(type='submit') Mark Completed
          form(method='POST' action='/delete')
            input(type='hidden', name='id', value=val.id)
            button.delete(type='submit') Delete

  script.
    // Show the edit form when "Edit Task" is clicked, hide it again on Cancel
    document.addEventListener('click', function (e) {
      var actions = e.target.closest('.actions');
      if (!actions) return;
      var toggle = actions.querySelector('.edit-toggle');
      var form = actions.querySelector('.edit-form');
      if (e.target.matches('.edit-toggle')) {
        toggle.hidden = true;
        form.hidden = false;
        form.querySelector('input[name=task]').focus();
      } else if (e.target.matches('.cancel-edit')) {
        form.reset();
        form.hidden = true;
        toggle.hidden = false;
      }
    });
